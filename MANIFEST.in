include scripts/*.py scripts/*.command scripts/*.cmd
recursive-include docs *.md
recursive-include docs/images *.png
recursive-include tests *.py *.imro *.meta
prune old
prune data
prune outputs
prune build
prune dist
prune .venv-registration
prune .venv
prune ProbeMap.app
global-exclude __pycache__ *.py[cod] .DS_Store
